<Window x:Class="CEMCP.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ce-mcp"
        Width="600"
        Height="680"
        MinWidth="540"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Color x:Key="DarkBg">#171717</Color>
        <Color x:Key="DarkSurface">#242424</Color>
        <Color x:Key="DarkFg">#F3F3F3</Color>
        <Color x:Key="DarkMutedFg">#B8B8B8</Color>
        <Color x:Key="DarkTextBoxBg">#2D2D2D</Color>
        <Color x:Key="DarkTextBoxBorder">#555555</Color>
        <Color x:Key="DarkBtnBg">#3B3B3B</Color>
        <Color x:Key="DarkBtnBorder">#626262</Color>
        <Color x:Key="DarkBtnDisabledBg">#2A2A2A</Color>
        <Color x:Key="DarkBtnDisabledFg">#777777</Color>
        <Color x:Key="DarkAccent">#5B9DFF</Color>

        <Color x:Key="LightBg">#F5F5F5</Color>
        <Color x:Key="LightSurface">#FFFFFF</Color>
        <Color x:Key="LightFg">#202020</Color>
        <Color x:Key="LightMutedFg">#606060</Color>
        <Color x:Key="LightTextBoxBg">#FFFFFF</Color>
        <Color x:Key="LightTextBoxBorder">#A6A6A6</Color>
        <Color x:Key="LightBtnBg">#F0F0F0</Color>
        <Color x:Key="LightBtnBorder">#A6A6A6</Color>
        <Color x:Key="LightBtnDisabledBg">#E8E8E8</Color>
        <Color x:Key="LightBtnDisabledFg">#929292</Color>
        <Color x:Key="LightAccent">#1769C2</Color>

        <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource LightBg}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource LightSurface}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource LightFg}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource LightMutedFg}"/>
        <SolidColorBrush x:Key="TextBoxBgBrush" Color="{StaticResource LightTextBoxBg}"/>
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="{StaticResource LightTextBoxBorder}"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="{StaticResource LightBtnBg}"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="{StaticResource LightBtnBorder}"/>
        <SolidColorBrush x:Key="BtnDisabledBgBrush" Color="{StaticResource LightBtnDisabledBg}"/>
        <SolidColorBrush x:Key="BtnDisabledFgBrush" Color="{StaticResource LightBtnDisabledFg}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource LightAccent}"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextBoxBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThemedButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource BtnDisabledBgBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource BtnDisabledFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ThemedButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="ce-mcp server"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Configure the local MCP endpoint used by Claude and other MCP clients."
                               Style="{StaticResource MutedText}"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TextBoxBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{Binding ServerStatusColor}"
                                     Margin="0,0,9,0"/>
                            <TextBlock Text="Server status"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ServerStatus}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Version, StringFormat=Version {0}}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TextBoxBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Connection"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Settings are locked while the server is running. Stop it before changing the endpoint."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,15"
                                   TextWrapping="Wrap"/>

                        <Grid IsEnabled="{Binding CanEditConfiguration}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Host or IP"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     x:Name="hostTextBox"
                                     MaxLength="253"
                                     Margin="0,0,0,10"
                                     ToolTip="Use 127.0.0.1 to accept connections only from this computer."
                                     Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Port"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     x:Name="portTextBox"
                                     MaxLength="5"
                                     Margin="0,0,0,10"
                                     ToolTip="TCP port from 1 through 65535."
                                     Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Server name"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     x:Name="serverNameTextBox"
                                     MaxLength="128"
                                     Text="{Binding ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Text="MCP endpoint"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <Border Background="{DynamicResource WindowBgBrush}"
                                BorderBrush="{DynamicResource TextBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="copyUrlButton"
                                        DockPanel.Dock="Right"
                                        Content="Copy URL"
                                        Style="{StaticResource ThemedButton}"
                                        MinWidth="88"
                                        Margin="10,0,0,0"
                                        Click="CopyUrlButton_Click"/>
                                <TextBlock Text="{Binding BaseUrl}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Security: keep 127.0.0.1 unless remote access is intentional. Other host values may expose process-control tools to your network."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <WrapPanel Grid.Row="3"
                           Orientation="Horizontal"
                           Margin="0,0,0,14">
                    <Button x:Name="startStopButton"
                            Content="{Binding StartStopButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Click="StartStopButton_Click"/>
                    <Button x:Name="saveButton"
                            Content="_Save settings"
                            IsEnabled="{Binding CanEditConfiguration}"
                            Style="{StaticResource ThemedButton}"
                            Click="SaveButton_Click"/>
                    <Button x:Name="testButton"
                            Content="_Test connection"
                            Style="{StaticResource ThemedButton}"
                            Click="TestButton_Click"/>
                </WrapPanel>

                <Border Grid.Row="4"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource TextBoxBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        MinHeight="48">
                    <TextBlock Text="{Binding TestResult}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
